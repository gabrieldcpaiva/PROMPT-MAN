# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Obtain a key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: Configurable server-side model identifier for prompt optimization.
# Defaults to "gemini-4-argon". The app does not silently substitute another model.
GEMINI_MODEL="gemini-4-argon"

# PORT: Server port for local development and production (defaults to 3000).
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
